      {
        "chat_id": "oc_81d4242ac0d1f01115a616d1be0bf5c1",
        "content": "SELECT * FROM (\nSELECT \nh.orm_no AS '履行订单号',\nm.dict_item_name AS '履行订单类型',\nh.orm_status AS '履行订单节点',\nme.employee_name AS '订单统筹',\nme2.employee_name AS '产品统筹',\nmo.org_name AS '履行中心',\nmo2.org_name AS '交易主体',\nmc.customer_name AS '客户名称',\ne.orm_line_no AS '履行订单行号',\nmi.item_code AS '物料编码',\nom.demand_date AS '需求自制上线日期',\ne.rsd AS '需求发货日期',\ne.crd AS '需求到货日期',\ne.rpd AS '需求入库日期',\nom.promise_date AS '承诺自制上线日期',\ne.esd AS '承诺发货日期',\ne.eta AS '承诺到货日期',\ne.epd AS '承诺入库日期',\nch.cir_no AS '到货需求号',\nmch.dict_item_name AS '到货需求类型',\nmp.project_code AS '项目编码',\nmp.project_name AS '项目名称',\nchme.employee_name AS '商务人员信息',\nchme2.employee_name AS '销售员姓名',\ns.supply_no AS '任务令',\nme3.employee_name AS '加工计划',\na.creation_date\nFROM osp_atp_assigments a\nJOIN osp_demands d ON d.demand_id = a.demand_id\nJOIN orm_line e ON e.orm_line_id = d.source_id\nJOIN orm_head h ON e.orm_head_id = h.orm_head_id\nLEFT JOIN adt_dict_items m ON h.orm_type = m.dict_item_code AND m.dict_type_code = 'ORM_TYPE'\nLEFT JOIN mdm_employee me ON me.employee_id = h.order_coordination\nLEFT JOIN mdm_employee me2 ON me2.employee_id = h.fulfillment_specialist\nLEFT JOIN mdm_org mo ON mo.org_id = h.orm_center\nLEFT JOIN mdm_org mo2 ON mo2.org_id = h.sign_party_id\nLEFT JOIN mdm_customer mc ON mc.customer_id = h.customer_id\nLEFT JOIN mdm_item mi ON mi.mdm_item_id = e.mdm_item_id\nLEFT JOIN orm_milestone om ON om.orm_line_id = e.orm_line_id AND om.milestone_code = 'md11495_1'\nLEFT JOIN cir_head ch ON ch.cir_head_id = h.source_id\nLEFT JOIN adt_dict_items mch ON ch.cir_type = mch.dict_item_code AND mch.dict_type_code = 'CIR_TYPE'\nLEFT JOIN mdm_project mp ON ch.project_id = mp.project_id\nLEFT JOIN mdm_employee chme ON chme.employee_id = ch.business_person_id\nLEFT JOIN mdm_employee chme2 ON chme2.employee_id = ch.salesperson_id\nLEFT JOIN osp_supplies s ON s.supply_id = a.supply_id AND s.plan_batch_id = a.plan_batch_id\nLEFT JOIN mdm_employee me3 ON me3.employee_id = e.processing_plan\nORDER BY a.creation_date DESC \n) a GROUP BY a.`履行订单号`,a.`履行订单行号`,a.`任务令`",
